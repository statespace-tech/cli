# Run the shop with `ssp host` under systemd, on a machine with the shop built
# in /srv/shop (see build.sh). Install with:
#
#   sudo cp ssp-host.service /etc/systemd/system/shop.service
#   sudo systemctl edit shop     # add Environment=SSP_API_KEY=... and SSP_TRUST_KEY=...
#   sudo systemctl enable --now shop
[Unit]
Description=Shop behind ssp host
After=network-online.target
Wants=network-online.target

[Service]
User=shop
WorkingDirectory=/srv/shop
Environment=STATESPACE_APP=shop
Environment=STATESPACE_LISTEN=0.0.0.0:8080
CacheDirectory=statespace
Environment=STATESPACE_CACHE=%C/statespace
ExecStart=/usr/local/bin/ssp host --health /health --trust-key ${SSP_TRUST_KEY} \
    --command "PYTHONPATH=deps exec python3 -m uvicorn main:app --host 127.0.0.1 --port {port} --workers 2" \
    --capture stderr --redact sk_live_\\w+
# ssp host stops every process it started; give requests time to finish.
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
